        background: #4a6741 !important;
        color: #fff !important;
    }
`;
document.head.appendChild(style);

/**
 * Плавный скролл к якорям
 */
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        if (href === '#') return;
        
        const target = document.querySelector(href);
        if (!target) return;
        
        e.preventDefault();
        target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
        });
    });
});

/**
 * Параллакс эффект для hero секции
 */
const hero = document.querySelector('.hero');
if (hero) {
    window.addEventListener('scroll', function() {
        const scrolled = window.pageYOffset;
        const heroImage = hero.querySelector('.hero-image');
        
        if (heroImage && scrolled < window.innerHeight) {
            heroImage.style.transform = `translateY(calc(-50% + ${scrolled * 0.3}px))`;
        }
    });
}

/**
 * Inline Editing System for Admin
 */
(function() {
    // Check if admin mode
    const editables = document.querySelectorAll('.editable');
    if (editables.length === 0) return;
    
    // Create save notification
    const notification = document.createElement('div');
    notification.className = 'save-notification';
    notification.innerHTML = '<i class="fas fa-check"></i> <span>Сохранено!</span>';
    document.body.appendChild(notification);
    
    // Show notification
    function showNotification(message, isError = false) {
        notification.innerHTML = `<i class="fas fa-${isError ? 'times' : 'check'}"></i> <span>${message}</span>`;
        notification.classList.toggle('error', isError);
        notification.classList.add('show');
        setTimeout(() => notification.classList.remove('show'), 2000);
    }
    
    // Save content to server
    function saveContent(key, value) {
        fetch(BASE_PATH + 'pages/save_content.php', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `key=${encodeURIComponent(key)}&value=${encodeURIComponent(value)}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification('Сохранено!');
            } else {
                showNotification(data.message || 'Ошибка сохранения', true);
            }
        })
        .catch(error => {
            showNotification('Ошибка соединения', true);
            console.error('Save error:', error);
        });
    }
    
    // Debounce function
    function debounce(func, wait) {
        let timeout;
        return function(...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(this, args), wait);
        };
    }
    
    // Handle editable elements
    editables.forEach(el => {
        const key = el.dataset.key;
        if (!key) return;
        
        // Wrap in container for positioning
        const wrapper = document.createElement('span');
        wrapper.className = 'editable-wrapper';
        wrapper.style.display = el.tagName === 'SPAN' ? 'inline' : 'block';
        el.parentNode.insertBefore(wrapper, el);
        wrapper.appendChild(el);
        
        // Move edit button inside wrapper
        const editBtn = el.nextElementSibling;
        if (editBtn && editBtn.classList.contains('edit-btn')) {
            wrapper.appendChild(editBtn);
        }
        
        // Save on blur with debounce
        const debouncedSave = debounce((value) => {
            saveContent(key, value);
        }, 1000);
        
        // Input handler
        el.addEventListener('input', function() {
            debouncedSave(this.textContent);
        });
        
        // Save on blur
        el.addEventListener('blur', function() {
            saveContent(key, this.textContent);
        });
        
        // Prevent enter creating new lines in single-line elements
        if (el.tagName !== 'P' && el.tagName !== 'DIV') {
            el.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    this.blur();
                }
            });
        }
    });
})();

// Edit button click handler
function editElement(el) {
    if (el && el.focus) {
        el.focus();
        // Place cursor at end
        const range = document.createRange();
        const sel = window.getSelection();
        range.selectNodeContents(el);
        range.collapse(false);
        sel.removeAllRanges();
        sel.addRange(range);
    }
}
